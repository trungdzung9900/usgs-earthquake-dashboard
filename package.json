{
  "name": "usgs-earthquake-dashboard",
  "private": true,
  "engines": { "node": ">=20" },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm run start:dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "start": "node backend/dist/main.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1"
  },
  "lint-staged": {
    "backend/src/**/*.ts": [
      "prettier --write",
      "oxlint"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "prettier --write",
      "oxlint"
    ]
  }
}
